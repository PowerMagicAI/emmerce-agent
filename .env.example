# EMMERCE_LLM_PROVIDER=stub|qwen|zhipu|modelscope|openai|deepseek
EMMERCE_LLM_PROVIDER=deepseek
EMMERCE_LLM_API_KEY=
EMMERCE_LLM_BASE_URL=https://api.deepseek.com/v1
EMMERCE_LLM_MODEL=deepseek-v4-flash
# 1 = enable thinking (higher latency/quota); 0 = prefer non-thinking
EMMERCE_LLM_ENABLE_THINKING=0

EMMERCE_WAREHOUSE_BACKEND=memory
# 可复现 CSV；空则使用仓库内 datasets/demo
# EMMERCE_DATASET_DIR=datasets/demo
# memory|sqlite — sqlite survives process restart (single node)
EMMERCE_MEMORY_BACKEND=memory
EMMERCE_SQLITE_PATH=./data/emmerce_episodic.db
EMMERCE_SESSION_BACKEND=memory
EMMERCE_SESSION_SQLITE=./data/emmerce_sessions.db
EMMERCE_DATA_AS_OF=2026-08-04T08:00:00+08:00
EMMERCE_MAX_TOOL_ROUNDS=8
# Dual guard with max tool rounds: estimated tokens per chat turn
EMMERCE_MAX_TURN_TOKENS=32000
EMMERCE_AUDIT_MAXLEN=2000
EMMERCE_TOOL_RPM=20
# Optional: use full jsonschema lib when installed (pip install jsonschema)
EMMERCE_JSONSCHEMA=0
EMMERCE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Demo HMAC; change before any shared deployment
EMMERCE_AUTH_SECRET=emmerce-dev-change-me
EMMERCE_AUTH_TTL_HOURS=12
# 1 = reject ungrounded money-like numbers in assistant text
EMMERCE_STRICT_TEXT_NUMBERS=1
